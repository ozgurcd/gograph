      "path": "catalog/catalog.go",
      "language": "go",
      "lines": [
        "package catalog",
        "",
        "import \"context\"",
        "",
        "type Product struct {",
        "\tID    string",
        "\tStock int",
        "}",
        "",
        "type ProductRepository interface {",
        "\tFind(context.Context, string) (Product, error)",
        "\tSave(context.Context, Product) error",
        "}"
      ]
    },
    {
      "path": "httpapi/handler.go",
      "language": "go",
      "lines": [
        "package httpapi",
        "",
        "import (",
        "\t\"net/http\"",
        "\t\"strings\"",
        "",
        "\t\"example.com/refactorshop/service\"",
        ")",
        "",
        "type Handler struct {",
        "\tcheckout *service.CheckoutService",
        "}",
        "",
        "func NewHandler(checkout *service.CheckoutService) *Handler {",
        "\treturn &Handler{checkout: checkout}",
        "}",
        "",
        "func (h *Handler) Checkout(w http.ResponseWriter, r *http.Request) {",
        "\tproductID := strings.TrimPrefix(r.URL.Path, \"/checkout/\")",
        "\tif _, err := h.checkout.Checkout(r.Context(), productID); err != nil {",
        "\t\thttp.Error(w, err.Error(), http.StatusBadRequest)",
        "\t\treturn",
        "\t}",
        "\tw.WriteHeader(http.StatusNoContent)",
        "}",
        "",
        "func Register(mux *http.ServeMux, handler *Handler) {",
        "\tmux.HandleFunc(\"/checkout/\", handler.Checkout)",
        "}"
      ]
    },
    {
      "path": "memory/repository.go",
      "language": "go",
      "lines": [
        "package memory",
        "",
        "import (",
        "\t\"context\"",
        "\t\"fmt\"",
        "\t\"sync\"",
        "",
        "\t\"example.com/refactorshop/catalog\"",
        ")",
        "",
        "type MemoryRepository struct {",
        "\tmu       sync.Mutex",
        "\tproducts map[string]catalog.Product",
        "}",
        "",
        "func NewRepository(products ...catalog.Product) *MemoryRepository {",
        "\tstored := make(map[string]catalog.Product, len(products))",
        "\tfor _, product := range products {",
        "\t\tstored[product.ID] = product",
        "\t}",
        "\treturn &MemoryRepository{products: stored}",
        "}",
        "",
        "func (r *MemoryRepository) Find(_ context.Context, id string) (catalog.Product, error) {",
        "\tr.mu.Lock()",
        "\tdefer r.mu.Unlock()",
        "\tproduct, ok := r.products[id]",
        "\tif !ok {",
        "\t\treturn catalog.Product{}, fmt.Errorf(\"product %q not found\", id)",
        "\t}",
        "\treturn product, nil",
        "}",
        "",
        "func (r *MemoryRepository) Save(_ context.Context, product catalog.Product) error {",
        "\tr.mu.Lock()",
        "\tdefer r.mu.Unlock()",
        "\tr.products[product.ID] = product",
        "\treturn nil",
        "}"
      ]
    },
    {
      "path": "service/checkout.go",
      "language": "go",
      "lines": [
        "package service",
        "",
        "import (",
        "\t\"context\"",
        "\t\"fmt\"",
        "",
        "\t\"example.com/refactorshop/catalog\"",
        ")",
        "",
        "type CheckoutService struct {",
        "\trepository catalog.ProductRepository",
        "}",
        "",
        "func NewCheckoutService(repository catalog.ProductRepository) *CheckoutService {",
        "\treturn &CheckoutService{repository: repository}",
        "}",
        "",
        "func ReserveStock(product catalog.Product) (catalog.Product, error) {",
        "\tif product.Stock == 0 {",
        "\t\treturn catalog.Product{}, fmt.Errorf(\"product %q is out of stock\", product.ID)",
        "\t}",
        "\tproduct.Stock--",
        "\treturn product, nil",
        "}",
        "",
        "func (s *CheckoutService) Checkout(ctx context.Context, productID string) (catalog.Product, error) {",
        "\tproduct, err := s.repository.Find(ctx, productID)",
        "\tif err != nil {",
        "\t\treturn catalog.Product{}, fmt.Errorf(\"find product: %w\", err)",
        "\t}",
        "\tproduct, err = ReserveStock(product)",
        "\tif err != nil {",
        "\t\treturn catalog.Product{}, err",
        "\t}",
        "\tif err := s.repository.Save(ctx, product); err != nil {",
        "\t\treturn catalog.Product{}, fmt.Errorf(\"save product: %w\", err)",
        "\t}",
        "\treturn product, nil",
        "}"
      ]
    },
    {
      "path": "service/checkout_test.go",
      "language": "go",
      "lines": [
        "package service_test",
        "",
        "import (",
        "\t\"context\"",
        "\t\"testing\"",
        "",
        "\t\"example.com/refactorshop/catalog\"",
        "\t\"example.com/refactorshop/memory\"",
        "\t\"example.com/refactorshop/service\"",
        ")",
        "",
        "func TestCheckoutDecrementsStock(t *testing.T) {",
        "\trepository := memory.NewRepository(catalog.Product{ID: \"gopher\", Stock: 2})",
        "\tcheckout := service.NewCheckoutService(repository)",
        "",
        "\tproduct, err := checkout.Checkout(context.Background(), \"gopher\")",
        "\tif err != nil {",
        "\t\tt.Fatal(err)",
        "\t}",
        "\tif product.Stock != 1 {",
        "\t\tt.Fatalf(\"stock = %d, want 1\", product.Stock)",
        "\t}",
        "}",
        "",
        "func TestReserveStockRejectsEmptyInventory(t *testing.T) {",
        "\t_, err := service.ReserveStock(catalog.Product{ID: \"gopher\"})",
        "\tif err == nil {",
        "\t\tt.Fatal(\"ReserveStock returned nil error for empty inventory\")",
        "\t}",
        "}"
      ]
    },
    {
      "path": "sqlrepo/repository.go",
      "language": "go",
      "lines": [
        "package sqlrepo",
        "",
        "import (",
        "\t\"context\"",
        "\t\"database/sql\"",
        "",
        "\t\"example.com/refactorshop/catalog\"",
        ")",
        "",
        "type SQLRepository struct {",
        "\tdb *sql.DB",
        "}",
        "",
        "func NewRepository(db *sql.DB) *SQLRepository {",
        "\treturn &SQLRepository{db: db}",
        "}",
        "",
        "func (r *SQLRepository) Find(ctx context.Context, id string) (catalog.Product, error) {",
        "\tvar product catalog.Product",
        "\terr := r.db.QueryRowContext(ctx, \"SELECT id, stock FROM products WHERE id = ?\", id).Scan(&product.ID, &product.Stock)",
        "\treturn product, err",
        "}",
        "",
        "func (r *SQLRepository) Save(ctx context.Context, product catalog.Product) error {",
        "\t_, err := r.db.ExecContext(ctx, \"UPDATE products SET stock = ? WHERE id = ?\", product.Stock, product.ID)",
        "\treturn err",
        "}"
      ]
    }
